<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_iridiscente"
    android:fillViewport="true"
    android:padding="20dp"
    tools:context=".LoginActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Header Brand Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="LocalCash"
                    android:textAlignment="center"
                    android:textColor="@color/texto_oceano"
                    android:textSize="28sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- Card de Login (Si existe cuenta registrada en SQLite) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="32dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/glass_fondo"
            app:strokeColor="@color/glass_borde_brillo"
            app:strokeWidth="0.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="24dp">

                <!-- Avatar Profile -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/glass_fondo"
                    app:strokeColor="@color/glass_borde_brillo"
                    app:strokeWidth="0.5dp">

                    <TextView
                        android:id="@+id/tvUserInitial"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text=""
                        tools:text="T"
                        android:textColor="@color/texto_oceano"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvUserLoginTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    tools:text="Nombre del Titular"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/texto_oceano"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:id="@+id/tvUserAccountSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    tools:text="RUT: 19.876.543-2 • CuentaRUT"
                    android:textSize="13sp"
                    android:textColor="@color/texto_oceano"
                    android:layout_marginTop="2dp" />

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/lottieFingerprint"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    app:lottie_rawRes="@raw/lottie_fingerprint"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true" />

                <TextView
                    android:id="@+id/tvAuthStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ingresa con tu huella dactilar"
                    android:textSize="13sp"
                    android:textColor="@color/texto_oceano"
                    android:layout_marginBottom="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLoginBiometric"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Ingresar con Huella"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    app:cornerRadius="27dp"
                    android:backgroundTint="@color/texto_oceano" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGoToRegister"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Registrar otra cuenta"
                    android:textColor="@color/texto_oceano"
                    android:textSize="13sp"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Card de Registro (Estándar Financiero Chileno: RUT, CuentaRUT, CLP) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:visibility="gone"
            app:cardCornerRadius="32dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/glass_fondo"
            app:strokeColor="@color/glass_borde_brillo"
            app:strokeWidth="0.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nueva Cuenta Bancaria"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/texto_oceano"
                    android:layout_marginBottom="16dp" />

                <!-- Campo Titular -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nombre completo del titular"
                    android:textColorHint="@color/texto_oceano"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    app:boxStrokeColor="@color/texto_oceano"
                    app:hintTextColor="@color/texto_oceano"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTitular"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:textColor="@color/texto_oceano" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Campo RUT / N° Cuenta -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="RUT o Número de Cuenta (ej. 19.876.543-2)"
                    android:textColorHint="@color/texto_oceano"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    app:boxStrokeColor="@color/texto_oceano"
                    app:hintTextColor="@color/texto_oceano"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNumeroCuenta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:text="19.876.543-2"
                        android:textColor="@color/texto_oceano" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Campo Tipo de Cuenta (Estándar Chileno) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Tipo de Cuenta (ej. CuentaRUT, Cuenta Corriente)"
                    android:textColorHint="@color/texto_oceano"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    app:boxStrokeColor="@color/texto_oceano"
                    app:hintTextColor="@color/texto_oceano"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTipoCuenta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:text="CuentaRUT"
                        android:textColor="@color/texto_oceano" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Campo Saldo Inicial CLP -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Saldo Inicial CLP ($)"
                    android:textColorHint="@color/texto_oceano"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    app:boxStrokeColor="@color/texto_oceano"
                    app:hintTextColor="@color/texto_oceano"
                    android:layout_marginBottom="20dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSaldo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:text="150000"
                        android:textColor="@color/texto_oceano" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Botón Crear -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCrearCuenta"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Crear Cuenta"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    app:cornerRadius="27dp"
                    android:backgroundTint="@color/texto_oceano" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBackToLogin"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Volver"
                    android:textColor="@color/texto_oceano"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Quick Access Bottom Shortcuts -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp">

            <!-- Shortcut 1: Mapa -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnNavMapLogin"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/glass_fondo"
                app:strokeColor="@color/glass_borde_brillo"
                app:strokeWidth="0.5dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:padding="12dp"
                    android:background="@null">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@android:drawable/ic_dialog_map"
                        app:tint="@color/texto_oceano" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mapa"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/texto_oceano"
                        android:layout_marginStart="8dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Shortcut 2: Ayuda -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnAyudaLogin"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/glass_fondo"
                app:strokeColor="@color/glass_borde_brillo"
                app:strokeWidth="0.5dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:padding="12dp"
                    android:background="@null">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@android:drawable/ic_menu_help"
                        app:tint="@color/texto_oceano" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ayuda"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/texto_oceano"
                        android:layout_marginStart="8dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>

<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Base Violeta Oscuro Obsidian -->
    <path
        android:fillColor="#2B1E4A"
        android:pathData="M0,0h108v108h-108z" />

    <!-- Degradado Diagonal Holográfico -->
    <path
        android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0.0" android:color="#2B1E4A" />
                <item android:offset="0.5" android:color="#4A3B78" />
                <item android:offset="1.0" android:color="#1A1230" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Brillo Neón Menta (Superior Derecho) -->
    <path
        android:pathData="M60,10 A38,38 0 1,1 106,56 A38,38 0 1,1 60,10 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="60"
                android:startY="10"
                android:endX="100"
                android:endY="50"
                android:type="linear">
                <item android:offset="0.0" android:color="#5500B894" />
                <item android:offset="1.0" android:color="#0000B894" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Resplandor Rosa Bebé / Lavanda (Inferior Izquierdo) -->
    <path
        android:pathData="M2,62 A36,36 0 1,1 74,106 A36,36 0 1,1 2,62 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="10"
                android:startY="98"
                android:endX="60"
                android:endY="50"
                android:type="linear">
                <item android:offset="0.0" android:color="#44FFC2D4" />
                <item android:offset="1.0" android:color="#00E0D7FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Reflejo Sutil estilo Liquid Glass -->
    <path
        android:pathData="M-10,30 L118,-10 L128,0 L-0,40 Z"
        android:fillColor="#12FFFFFF" />
</vector>
